{
  "name": "laundry-app",
  "private": true,
  "version": "0.0.0",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev:backend": "npm run dev -w laundry-backend",
    "dev:prototype": "npm run dev -w laundry-prototype",
    "dev:admin": "npm run dev -w laundry-admin-dashboard",
    "build:backend": "npm run build -w laundry-backend",
    "build:prototype": "npm run build -w laundry-prototype",
    "build:admin": "npm run build -w laundry-admin-dashboard",
    "start:backend": "npm run start -w laundry-backend",
    "start:admin": "npm run start -w laundry-admin-dashboard",
    "seed:e2e": "npm run seed:e2e -w laundry-backend",
    "test:e2e:admin": "npm run test:e2e -w laundry-admin-dashboard"
  },
  "engines": {
    "node": ">=18"
  },
  "overrides": {
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "laundry-prototype": {
      "react": "19.3.0",
      "react-dom": "19.3.0"
    }
  }
}
