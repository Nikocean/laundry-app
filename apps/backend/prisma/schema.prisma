generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  customer
  courier
  admin

  @@map("user_role")
}

enum OrderStatus {
  pending
  picked_up
  washing
  done
  delivering
  delivered
  cancelled

  @@map("order_status")
}

model User {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name         String
  email        String    @unique
  passwordHash String    @map("password_hash")
  phone        String?
  role         UserRole  @default(customer)
  fcmToken     String?   @map("fcm_token")
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz

  addresses      Address[]
  courier        Courier?
  ordersAsCustomer Order[] @relation("OrderCustomer")
  ordersAsCourier  Order[] @relation("OrderCourier")
  notifications  Notification[]
  refreshTokens  RefreshToken[]

  @@map("users")
}

// Auth support table for REQ-AUTH-05 (refresh revoke/rotate). Not in ERD section 3.
model RefreshToken {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @map("token_hash")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "idx_refresh_tokens_user")
  @@index([tokenHash], map: "idx_refresh_tokens_hash")
  @@map("refresh_tokens")
}

model Address {
  id          String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId      String  @map("user_id") @db.Uuid
  label       String
  fullAddress String  @map("full_address")
  latitude    Float
  longitude   Float
  isDefault   Boolean @default(false) @map("is_default")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("addresses")
}

model Courier {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId       String    @unique @map("user_id") @db.Uuid
  isAvailable  Boolean   @default(false) @map("is_available")
  currentLat   Float?    @map("current_lat")
  currentLng   Float?    @map("current_lng")
  lastActiveAt DateTime? @map("last_active_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([isAvailable], map: "idx_couriers_available")
  @@map("couriers")
}

model Order {
  id                String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  customerId        String      @map("customer_id") @db.Uuid
  courierId         String?     @map("courier_id") @db.Uuid
  status            OrderStatus @default(pending)
  pickupAddress     String      @map("pickup_address")
  deliveryAddress   String      @map("delivery_address")
  totalPrice        Decimal     @default(0) @map("total_price") @db.Decimal(12, 2)
  paymentStatus     String      @default("unpaid") @map("payment_status")
  proofPhotoUrl     String?     @map("proof_photo_url")
  scheduledPickupAt DateTime?   @map("scheduled_pickup_at") @db.Timestamptz
  estimatedDoneAt   DateTime?   @map("estimated_done_at") @db.Timestamptz
  createdAt         DateTime    @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime    @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  customer User  @relation("OrderCustomer", fields: [customerId], references: [id])
  courier  User? @relation("OrderCourier", fields: [courierId], references: [id])
  items    OrderItem[]
  payment  Payment?

  @@index([customerId], map: "idx_orders_customer")
  @@index([courierId], map: "idx_orders_courier")
  @@index([status], map: "idx_orders_status")
  @@map("orders")
}

model OrderItem {
  id         String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId    String  @map("order_id") @db.Uuid
  name       String
  weightKg   Decimal @map("weight_kg") @db.Decimal(6, 2)
  pricePerKg Decimal @map("price_per_kg") @db.Decimal(10, 2)
  subtotal   Decimal @db.Decimal(12, 2)

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("order_items")
}

model Payment {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId       String    @unique @map("order_id") @db.Uuid
  method        String
  status        String    @default("pending")
  transactionId String?   @map("transaction_id")
  amount        Decimal   @db.Decimal(12, 2)
  paidAt        DateTime? @map("paid_at") @db.Timestamptz

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("payments")
}

model Notification {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  title     String
  body      String
  type      String
  isRead    Boolean  @default(false) @map("is_read")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead], map: "idx_notifications_user_unread")
  @@map("notifications")
}

// REQ-REPORT-*: not in ERD section 3 — daily revenue snapshot table.
model DailyReport {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  reportDate   DateTime @unique @map("report_date") @db.Date
  totalRevenue Decimal  @map("total_revenue") @db.Decimal(12, 2)
  orderCount   Int      @map("order_count")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@map("daily_reports")
}
