# Backend API base URL (server-side only; used by Next.js Route Handlers / RSC as BFF)
BACKEND_URL=http://localhost:3000

# Must match apps/backend JWT_ACCESS_SECRET (Edge middleware verifies access JWT)
JWT_ACCESS_SECRET=change_me_access_secret

# Browser Socket.io client (public). Same host/port as backend HTTP + Socket.io.
NEXT_PUBLIC_SOCKET_URL=http://localhost:3000

# Cookie names (optional — defaults shown; keep in sync with src/lib/auth/constants.ts)
# ACCESS_TOKEN_COOKIE=laundry_access_token
# REFRESH_TOKEN_COOKIE=laundry_refresh_token

# --- Playwright E2E (optional overrides; local fixtures only — set explicitly in CI) ---
# E2E_BASE_URL=http://localhost:3001
# E2E_BACKEND_URL=http://localhost:3000
# E2E_ADMIN_EMAIL=
# E2E_ADMIN_PASSWORD=
# E2E_CUSTOMER_EMAIL=
# E2E_CUSTOMER_PASSWORD=
# E2E_COURIER_EMAIL=
# E2E_COURIER_PASSWORD=
