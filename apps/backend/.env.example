DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"
PORT=3000
JWT_ACCESS_SECRET=change_me_access_secret
JWT_REFRESH_SECRET=change_me_refresh_secret
BCRYPT_COST=10
MIDTRANS_SERVER_KEY=SB-Mid-server-xxxxx
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@your-firebase-project-id.iam.gserviceaccount.com
# Prefer full PEM including BEGIN/END lines; raw PKCS#8 body also accepted.
# Use \n for newlines if the value is on one line.
FIREBASE_PRIVATE_KEY=

# Optional overrides for `npm run seed:e2e` (local-only fixtures; set these in CI)
# E2E_ADMIN_EMAIL=
# E2E_ADMIN_PASSWORD=
# E2E_CUSTOMER_EMAIL=
# E2E_CUSTOMER_PASSWORD=
# E2E_COURIER_EMAIL=
# E2E_COURIER_PASSWORD=
